VITE_APP_NAME=Workforce
VITE_APP_ENV=local
VITE_API_BASE_URL=http://localhost:8080
# 챗봇: 게이트웨이 /chat/** → member-service. 비우거나 변수 생략(권장). RAG는 /ai/** 별도 — /ai/chat 는 없음.
# VITE_CHAT_API_PREFIX=
# 선택. axios 기본 대기 시간(ms). 미설정 시 60000
# VITE_API_TIMEOUT_MS=60000
VITE_ENABLE_MSW=true
VITE_LOG_LEVEL=debug
VITE_SENTRY_DSN=
VITE_BUILD_COMMIT_SHA=
